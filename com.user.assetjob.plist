  <key>StartCalendarInterval</key>
  <dict>
    <key>Month</key>  <integer>6</integer>
    <key>Day</key>    <integer>13</integer>
    <key>Hour</key>   <integer>11</integer>
    <key>Minute</key> <integer>00</integer>
  </dict>
</dict>
</plist>
